[
  {
    "type": "ayah",
    "tr": {
      "text": "Allah kuluna kâfi değil midir?",
      "source": "Zümer, 36",
      "reflection": "Bu sözün içinde birkaç saniye kal."
    },
    "en": {
      "text": "Is Allah not sufficient for His servant?",
      "source": "Az-Zumar, 36",
      "reflection": "Stay with these words for a few seconds."
    }
  },
  {
    "type": "ayah",
    "tr": {
      "text": "Kalpler ancak Allah’ı anmakla huzur bulur.",
      "source": "Ra’d, 28",
      "reflection": "Kalbinin şu anki halini fark et."
    },
    "en": {
      "text": "Hearts find rest in the remembrance of Allah.",
      "source": "Ar-Ra’d, 28",
      "reflection": "Notice the state of your heart."
    }
  },
  {
    "type": "ayah",
    "tr": {
      "text": "Şüphesiz zorlukla beraber bir kolaylık vardır.",
      "source": "İnşirah, 6",
      "reflection": "Zorluğun içindeki kolaylığı düşün."
    },
    "en": {
      "text": "Indeed, with hardship comes ease.",
      "source": "Ash-Sharh, 6",
      "reflection": "Reflect on the ease hidden within hardship."
    }
  },
  {
    "type": "ayah",
    "tr": {
      "text": "Allah sabredenlerle beraberdir.",
      "source": "Bakara, 153",
      "reflection": "Bugün sabrettiğin bir anı hatırla."
    },
    "en": {
      "text": "Allah is with the patient.",
      "source": "Al-Baqarah, 153",
      "reflection": "Remember a moment when you were patient today."
    }
  },
  {
    "type": "asma",
    "arabic": "اللَّطِيف",
    "tr": {
